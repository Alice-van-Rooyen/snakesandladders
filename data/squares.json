{
  "_meta": {
    "version": 1,
    "notes": "Squares 1–100. Edit text and icon. Use null for no icon. Empty text is allowed."
  },

  "1":   { "You are discharged. Good luck!": "Start", "icon": null },
  "2":   { "Being upright smakcs of effort, you opt to be horizontal - a solid first move.": "", "icon": null },
  "3":   { "You think you'll have just one more day in bed before you start being production - adorable!": "", "icon": null },
  "4":   { "A friend reminds you that groceries can be delivered. You order them. You will not eat them.": "", "icon": null },
  "5":   { "You leave the hospital bubble and get a cold. You used to think this was what 'very poorly' meant. You know better now.": "", "icon": null },
  "6":   { "You think about showering, dressing, shopping, cooking - these remain bizzarely abstract concepts.": "", "icon": null },
  "7":   { "Deeply resentful at having to sort your own medication.": "", "icon": null },
  "8":   { "You open your email and remember you haven't dealt with any of it for 3 months. Today is also not that day. ": "", "icon": null },
  "9":   { "The kettle is too heavy. Your mug weighs a metric tonne. You have to sit on the floor to stop the kitchen spinning.": "", "icon": null },
  "10":  { "You are both ravenous and repulsed by most foods.": "", "icon": null },

  "11":  { "You have yet to have a proper night's sleep. You worry you are failing at recovery.": "", "icon": null },
  "12":  { "You feel nostalgia for your favourite nurses.": "", "icon": null },
  "13":  { "You emerge from your duvet cocoon, furious at the need to live up to your responsibilities.": "", "icon": null },
  "14":  { "You get a haircut and feel less like a feral hospital goblin.": "", "icon": null },
  "15":  { "You manage to shave your legs in the shower without falling over. Orthostatic what now? You celebrate ... prematurely.": "", "icon": null },
  "16":  { "You stand chatting in the park for 10 minutes and feel nauseous, sweaty, and faint - you beat a glacial retreat.": "", "icon": null },
  "17":  { "You continually tweak the shoulder muscles you strained in hospital. Holding a cup of tea is now a Herculean task.": "", "icon": null },
  "18":  { "Sulk because there is no one to bring you snacks.": "", "icon": null },
  "19":  { "You got to the theatre and manage all the steps. You feel absurdly proud of yourself.": "", "icon": null },
  "20":  { "Today we sleep. Existentially, you are a deflated marshmallow.": "", "icon": null },

  "21":  { "You restart an interrupted work project. You last half an hour before going back to bed.": "", "icon": null },
  "22":  { "Feel bad. Eat. Feel better. Surprise!": "", "icon": null },
  "23":  { "You find leftover hospital snacks in your fridge and have a full body shudder of revulsion.": "", "icon": null },
  "24":  { "Walk a quarter of a mile feeling dizzy the whole way. Will do it again tomorrow. Worst hoby EVER!": "", "icon": null },
  "25":  { "You're cold, you put on a jersey. You are now hotter than the earth's molten core.": "", "icon": null },
  "26":  { "You blow your hospital energy budget on an ontologically rejuvenating Caper. No regrets, but you still cry outside the pharmacy.": "", "icon": null },
  "27":  { "You stood up today. That's your quote. Lie down.": "", "icon": null },
  "28":  { "You read 2,000 pages of medical notes and find 4 things of interest. World's most boring novel. Zero stars.": "", "icon": null },
  "29":  { "You cry because your food delivery is delayed.": "", "icon": null },
  "30":  { "You start a journal of your experience - you call it 'The Shit Fit Chronicles'": "", "icon": null },

  "31":  { "A friend asks how you're doing - you give them a blow-by-blow account of your illness - you never want to speak to them again.": "", "icon": null },
  "32":  { "Your pile of NHS correspondence is bigger than your pension plan.": "", "icon": null },
  "33":  { "Walk to Greggs for fresh air, drop steak bake on yourself, and knock over your coffee. Fresh air is for losers.": "", "icon": null },
  "34":  { "You realise the hospital energy budget was a figment of your imagination.": "", "icon": null },
  "35":  { "You buy more groceries you are too tired to prepare. You will not eat any of these either.": "", "icon": null },
  "36":  { "'We forgot to mention' - too late, you had to find out through lived experience.": "", "icon": null },
  "37":  { "The Deliveroo man doesn't know your name, but he knows your secret code.": "", "icon": null },
  "38":  { "Someone makes a decision for you, not with you. Autonomy Override Alert activated.": "", "icon": null },
  "39":  { "You drop something on the floor. You debate whether you really need it. You do not. It lives there now.": "", "icon": null },
  "40":  { "Your brain is in cosmic inflation, your body hasn't been outside for 3 days.": "", "icon": null },

  "41":  { "You cry because you are cold and your jersey is beyond arm's reach.": "", "icon": null },
  "42":  { "The sun is SO loud!": "", "icon": null },
  "43":  { "You roll over in bed. Everything pops like bubble wrap.": "", "icon": null },
  "44":  { "Your arm hurts and you don't know why? It's your phantom PICC line.": "", "icon": null },
  "45":  { "Though precedes action. You think about tidying. Action TBD.": "", "icon": null },
  "46":  { "Your calves feel swollen. You Google compartment syndrome and ruminate on lower leg amputation. You take a nap.": "", "icon": null },
  "47":  { "You cry because you are awake + PAIN.": "", "icon": null },
  "48":  { "Your bestie comes to visit, stays in an hotel, cleans your house while you watch, and leaves early. You LOVE her!": "", "icon": null },
  "49":  { "You skip a work meeting because work is DUMB. New levels of self-advocacy and petulance unlock simultaneously.": "", "icon": null },
  "50":  { "You scroll for an hour before getting out of bed, then realise you're worn out and need a nap.": "", "icon": null },

  "51":  { "You book next week's gym sessions. Next Week You cancels all of them.": "", "icon": null },
  "52":  { "Someone tries to tell your story for you. You correct the narrative. Authorial Integrity retained.": "", "icon": null },
  "53":  { "You coin the term 'pus ferrets' to describe your drains and laugh until you cry. Core workout completed.": "", "icon": null },
  "54":  { "You insist you can do something. You cannot. The only person surprise is YOU.": "", "icon": null },
  "55":  { "You forget the real world is not hospital and go to Sainsbury's in your pyjamas.": "", "icon": null },
  "56":  { "You indulge your nerdery at a lecture and walk up 8 flights of stairs in the carpark without the handrail. You sing 'Eye of the Tiger' and shadow box with glee.": "", "icon": null },
  "57":  { "You used up a week's worth of energy posing at a lecture and parking on the 8th floor. Hubris, pure hubris.": "", "icon": null },
  "58":  { "Your empty pill box is a violation of your civil liberties.": "", "icon": null },
  "59":  { "Sleep. Wake. Snack. Sleep. It is what it is - this is what they mean by Zen.": "", "icon": null },
  "60":  { "Put clothes in the washing machine. They are now trapped in an infinity wash for 7 - 10 business days.": "", "icon": null },

  "61":  { "Your legs burn like fire ants have taken up residence in your epidermis.": "", "icon": null },
  "62":  { "You do 2 minutes on the rowing machine and feel 25 again. You sleep for the rest of the day - in your gym clothes.": "", "icon": null },
  "63":  { "Accept that your usual 6am start time is now 10am.": "", "icon": null },
  "64":  { "You buy another bottle of coke you can't open. A random passerby has to do it for you.": "", "icon": null },
  "65":  { "Check credit card statement - you've spent a month's salary on Just Eat. Feel depressed, order a burger.": "", "icon": null },
  "66":  { "You are dizzy standing up. You sit down. You are dizzy sitting down. You go to bed.": "", "icon": null },
  "67":  { "More groceries? You indefatigable optimist! You put another bin liner in, because ... well ...": "", "icon": null },
  "68":  { "Spend 5 hours on the sofa listening to your tinnitus with a cup of tea.": "", "icon": null },
  "69":  { "'You deserve a nap' - you realise rest is medicine not morality then take that nap. Go you!": "", "icon": null },
  "70":  { "You tell your 100th person 'I'm not very good at stairs at the moment'.": "", "icon": null },

  "71":  { "Too tired to shower. Too filthy not to.": "", "icon": null },
  "72":  { "You turn on your desk light and feel like you're being interrogated by the Stasi.": "", "icon": null },
  "73":  { "You try to be helpful. You are not. You have created more work.": "", "icon": null },
  "74":  { "NHS text reminders drive you bonkers, even though you still need them.": "", "icon": null },
  "75":  { "Your irritation at the term 'early convalescence' becomes reluctant acknowledgement that it's 'a thing' and you're doing it.": "", "icon": null },
  "76":  { "You mistake a long drive for a low-effort activity. Your small pain will now become BIG PAIN for at least 7 days.": "", "icon": null },
  "77":  { "You try to rate your pain but it involves the Fibonacci sequence.": "", "icon": null },
  "78":  { "You wear an actual outfit with accessories and perfume. You are back in your pyjamas by 3pm, but at least you smell good.": "", "icon": null },
  "79":  { "You eat an 'extended-family'-sized bar of chocolate. You would have preferred vegetables.": "", "icon": null },
  "80":  { "You are an obnoxious baby in physio. you cry, you eat, you sleep, you are filled with regret + PAIN.": "", "icon": null },

  "81":  { "You think 'maybe I'll go out today', the Gods of Convalescence laugh at your plans.": "", "icon": null },
  "82":  { "Your body temperature is now in Cryogenic Mode. Walt Disney is your new neighbour.": "", "icon": null },
  "83":  { "You try to salute a stupid driver and realise your middle finger is now in the target audience for Viagra.": "", "icon": null },
  "84":  { "You cry because ... honestly ... you forget why.": "", "icon": null },
  "85":  { "You spontaneously load and unload the dishwasher in the same 24 hour period. Heroic.": "", "icon": null },
  "86":  { "you buy groceries, cook them, and clean up all in the same hour. You nap to celebrate.": "", "icon": null },
  "87":  { "You felt great for two days in a row - have some crushing fatigure ... and PAIN.": "", "icon": null },
  "88":  { "Walking pace: geriatric tortoise on sedatives.": "", "icon": null },
  "89":  { "You finally understand that convalescence is a pattern of stable chaos. Your bed is the attractor.": "", "icon": null },
  "90":  { "Kitchen noises are a physical assault. You are filled with murderous noise-fuelled rage.": "", "icon": null },

  "91":  { "Can solve for 'x', cannot put away laundry.": "", "icon": null },
  "92":  { "You can sign your own name again, but the electrical storm in your hand is ongoing.": "", "icon": null },
  "93":  { "Your new love of steak bakes is a culinary violation of everything you stand for - you eat another one anyway.": "", "icon": null },
  "94":  { "Your carpet is an affront to decency, but the vacuum cleaner weighs more than a whale.": "", "icon": null },
  "95":  { "'That's perfectly normal' - now you tell me!": "", "icon": null },
  "96":  { "You have a day with no pain. You think you are cured - you are not.": "", "icon": null },
  "97":  { "You play the 'I nearly died' card with your brother during a vicious round of Uno - he plays the +5 card.": "", "icon": null },
  "98":  { "An acquaintance wants to visit. It's easier to unfriend them than tidy the house.": "", "icon": null },
  "99":  { "You compare weight loss wattles with a colleague on Ozempic. You're winning.": "", "icon": null },
  "100": { "'Early convalescence' is over. Advance to new levels of existential bullshit. Congratulations?": "Finish", "icon": null }
}
